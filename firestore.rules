rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Partite, News, Giocatori, Video:
    // tutti possono leggere (è il contenuto pubblico dell'app),
    // solo tu (loggato come admin) puoi scrivere/modificare/eliminare.
    match /matches/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /news/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /players/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /videos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /standings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /scorers_history/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Token di notifica push: ogni telefono può registrare/rimuovere
    // il PROPRIO token, ma nessuno (a parte il backend con la chiave
    // "account di servizio") può leggere l'elenco di tutti i token.
    match /pushTokens/{tokenId} {
      allow create, update, delete: if true;
      allow read: if false;
    }
  }
}
